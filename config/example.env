# Edit and source this file before running sc-pcQTL modules.

export SC_PCQTL_CODE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Authoritative primary-analysis eligibility contract. The released manifest
# retains cell types with at least 10,000 cells before pairwise testing.
export SC_PCQTL_CELLTYPE_MANIFEST="${SC_PCQTL_CODE_ROOT}/config/celltype_eligibility.tsv"

# Single-cell count matrices and gene coordinates.
export COQTL_DATA_ROOT="/path/to/per-celltype/readcount_tables"
export COQTL_COUNT_FILE=""
# SCTransform-corrected OneK1K B_IN matrix used by simulations and the three
# exploratory pair plots.
export COQTL_RAW_COUNTS_FILE="/path/to/OneK1K/SCT_corrected_count_matrix.tsv.gz"
export COQTL_GENE_INFO_FILE="/path/to/gene_info_with_location.tsv"
export COQTL_GENE_LOC_FILE="/path/to/GeneLocations.renamegene2.tsv"

# OneK1K single-gene eQTL and genotype resources.
export COQTL_SAIGEQTL_DIR="/path/to/OneK1K/original_single_gene_eqtl_tarballs"
export ONEK1K_EQTL_ROOT="${COQTL_SAIGEQTL_DIR}"
export ONEK1K_RAW_GENOTYPE_DIR="/path/to/OneK1K/plink/raw"
export ONEK1K_RAW_GENOTYPE_PREFIX="/path/to/OneK1K/plink/raw/full_genome_chr%s"
export ONEK1K_MAF005_GENOTYPE_PREFIX="/path/to/OneK1K/plink/maf_005/full_genome_chr%s.maf"
export ONEK1K_VARIANCE_RATIO_PLINK_PREFIX="/path/to/pruned/OneK1K_AllChr_pruned_10k_randomMarkers_forVR_fullsamples"
export ONEK1K_SUBSET_GENOTYPE_DIR="/path/to/OneK1K/subset/genotype"

# Tool paths.
export R_SCRIPT="${R_SCRIPT:-Rscript}"
export COQTL_RSCRIPT="${COQTL_RSCRIPT:-Rscript}"
export PLINK="${PLINK:-plink}"
export SMR_BIN="${SMR_BIN:-smr}"
export SAIGEQTL_SIF="/path/to/saigeqtl_0.3.4.sif"
export SAIGEQTL_RUNTIME="${SAIGEQTL_RUNTIME:-apptainer}"
# Optional project R library directories. Leave empty when packages are
# installed in a standard R library; set one directory in each variable.
export SC_PCQTL_R_LIBS=""
export SC_PCQTL_SHARED_R_LIBS=""

# Workflow roots used by downstream modules.
export SC_PCQTL_WORKFLOW_ROOT="/path/to/coQTL_workflow_outputs"
export COQTL_WORKFLOW_ROOT="${SC_PCQTL_WORKFLOW_ROOT}"
# Formal-colocalization results tree consumed by modules 06-11.
export COQTL_FORMAL_COLOC_ROOT="${COQTL_WORKFLOW_ROOT}/04_formal_colocalization"
export SC_PCQTL_FORMAL_COLOC_ROOT="${COQTL_FORMAL_COLOC_ROOT}"
export SC_PCQTL_UPSTREAM_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/03_analysis_celltypes/01_upstream_main_pipeline_add_cov"
export SC_PCQTL_UPSTREAM_CELLTYPES_ROOT="${SC_PCQTL_UPSTREAM_ROOT}/celltypes"
export SC_PCQTL_UPSTREAM_DATA_ROOT="${SC_PCQTL_UPSTREAM_ROOT}/data"
# Alias consumed by the S-LDSC input builder.
export COQTL_UPSTREAM_CELLTYPES_DIR="${SC_PCQTL_UPSTREAM_CELLTYPES_ROOT}"
export SC_PCQTL_CLUSTER_ENRICHMENT_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/03_analysis_celltypes/04_cluster_annotation_enrichment_add_cov"
export SC_PCQTL_CROSSMAP_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/05_review_resistance/wo05_cross_mappability"
export SC_PCQTL_JOINT_SCORE_COMPARISON_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/joint_p_test/comparison/tables"
export SC_PCQTL_SLDSC_BASE_ROOT="${SC_PCQTL_FORMAL_COLOC_ROOT}/08_heritability_enrichment_maxpip"
# Prespecified 247-trait analysis.
export SC_PCQTL_SLDSC_ROOT="${SC_PCQTL_SLDSC_BASE_ROOT}/runs/primary_10cell_prespecified247_rgpruned"
export SC_PCQTL_SLDSC_RESULT_ROOT="${SC_PCQTL_SLDSC_ROOT}"
# Optional cache from a previous run containing matching annotations and LD
# scores. Leave empty for a clean reconstruction.
export SC_PCQTL_SLDSC_ANNOTATION_CACHE_ROOT=""
export COQTL_SIM_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/02_simulations"
# Runtime simulation data are kept outside the immutable result directories.
export COQTL_SIM_DATA_ROOT="${COQTL_SIM_ROOT}/runtime_data"
export SC_PCQTL_MODEL_SIM_WORK_ROOT="${COQTL_SIM_ROOT}/00_from_start_simu"
export COQTL_SIM_NULL_ROOT="${COQTL_SIM_ROOT}/01_main_text_results/01_null_calibration_final_sc"
export COQTL_SIM_POWER_ROOT="${COQTL_SIM_ROOT}/01_main_text_results/02_power_analysis_final_sc"
export COQTL_WITHIN_DONOR_ROOT="${COQTL_SIM_ROOT}/03_sensitivity_within_donor_permutation"
export SC_PCQTL_HURDLE_SCRIPT_DIR="${SC_PCQTL_CODE_ROOT}/modules/01_pairwise_hurdle_clustering"
export SC_PCQTL_PCQTL_SUMMARY_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/03_analysis_celltypes/02_downstream_analysis_modules_add_cov_fdr/pcqtl_compare"
export SC_PCQTL_PCQTL_EGENE_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/03_analysis_celltypes/02_downstream_analysis_modules_add_cov_fdr/pcqtl_compare_saigeqtl"
export ONEK1K_QTL_LIFTOVER_POSMAP_PATTERN="${SC_PCQTL_FORMAL_COLOC_ROOT}/resources/onek1k_liftover/chr%s.hg19_to_hg38.posmap"
export SC_PCQTL_LOCUSZOOM_WORK_ROOT="${SC_PCQTL_FORMAL_COLOC_ROOT}/10_publication_locuszoom_redesign"
export SC_PCQTL_MANUSCRIPT_ROOT="/path/to/manuscript_checkout"
export SC_PCQTL_LOCUS_OUTPUT_DIR="${SC_PCQTL_MANUSCRIPT_ROOT}/figures/section4"
export SC_PCQTL_CLUSTER_LANDSCAPE_DATA="${SC_PCQTL_MANUSCRIPT_ROOT}/data/cluster_landscape"
export SC_PCQTL_CLUSTER_ENRICHMENT_FIGURE_OUTPUT_DIR="${SC_PCQTL_MANUSCRIPT_ROOT}/figures/section5"
export SC_PCQTL_SLDSC_FIGURE_OUTPUT_DIR="${SC_PCQTL_MANUSCRIPT_ROOT}/figures/section5"
# Final GIMAP pairwise-hurdle matrix generated by module 11.
export SC_PCQTL_GIMAP_COUNT_FILE="${SC_PCQTL_UPSTREAM_DATA_ROOT}/cd8_nc_readcounts.tsv"
export SC_PCQTL_GIMAP_LIBRARY_CACHE="${SC_PCQTL_UPSTREAM_CELLTYPES_ROOT}/cd8_nc/cluster_identification/results/method2_sc_hurdle/library_size_cache.tsv.gz"
export SC_PCQTL_GIMAP_HURDLE_MATRIX="${SC_PCQTL_MANUSCRIPT_ROOT}/data/gimap_pairwise_hurdle_matrix.tsv"
# Targeted module-03 SMR/HEIDI outputs for FinnGen R12 endpoint 3019198.
export SC_PCQTL_GIMAP_SMR_ROOT="${SC_PCQTL_WORKFLOW_ROOT}/03_analysis_celltypes/02_downstream_analysis_modules_add_cov_fdr/gimap_targeted_smr"
export SC_PCQTL_GIMAP_CLUSTER_SMR_SUMMARY="${SC_PCQTL_GIMAP_SMR_ROOT}/gimap_cluster_pcqtl_smr_summary.tsv"
export SC_PCQTL_GIMAP_GWAS_SMR_SUMMARY="${SC_PCQTL_GIMAP_SMR_ROOT}/gimap_gwas_smr_summary.tsv"

# FinnGen and LDSC resources.
export FINNGEN_ROOT="/path/to/finngen"
export FINNGEN_OFFICIAL_SUSIE_DIR="${FINNGEN_ROOT}/finemapping/r12_susie"
export FINNGEN_R12_RG_MATRIX="${FINNGEN_ROOT}/finngen_R12_FIN.ldsc.summary.tsv.gz"
export EUR_SLDSC_RESOURCE_DIR="${SC_PCQTL_SLDSC_ROOT}/resources/eur_sldsc_ref"
# 1000G EUR Phase3 PLINK reference used for the unified LocusZoom display-LD
# color scale in the module-10 representative-locus figures.
export EUR_PLINK_DIR="${EUR_SLDSC_RESOURCE_DIR}/1000G_EUR_Phase3_plink"
export LDSC_PYTHON="/path/to/python"
export LDSC_PY="/path/to/ldsc.py"
export MUNGE_SUMSTATS="/path/to/munge_sumstats.py"

# GIMAP cell-type-specificity / pseudobulk supplementary analysis
# (modules/10_representative_loci/gimap_celltype_specificity).
export ONEK1K_ROOT="/path/to/OneK1K"
export SC_PCQTL_BIND_ROOT="/path/to/container_bind_root"
export SC_PCQTL_GIMAP_SPECIFICITY_ROOT="/path/to/gimap_celltype_specificity_output"
export SC_PCQTL_GIMAP_MIXING_ROOT="${SC_PCQTL_GIMAP_SPECIFICITY_ROOT}/mixing/pseudobulk_tensorqtl"
# Per-cell GIMAP expression/covariate tables named
# <celltype>_gimap_covars.tsv.
export SC_PCQTL_GIMAP_SELECTED_READCOUNT_DIR="/path/to/staged/GIMAP_selected_readcounts"
