#!/usr/bin/env bash

# One cell type per invocation.
export SC_PCQTL_CELL_TYPE="b_in"
export COQTL_COUNT_FILE="/path/to/b_in_readcounts.tsv"
export COQTL_GENE_INFO_FILE="/path/to/gene_info_with_location.tsv"

# Immutable module-01 filtered-gene result for the same cell type.
export SC_PCQTL_PRIMARY_FILTERED_GENES_FILE="/path/to/primary/filtered_genes.tsv"

# Dedicated output root. Do not point this at the primary module-01 work tree.
export SC_PCQTL_JOINT_SCORE_WORK_DIR="/path/to/joint_score/celltypes/b_in/cluster_identification"

# Optional overrides.
export SC_PCQTL_LIBRARY_SIZE_CACHE=""
export SC_PCQTL_R_LIBS=""
export SC_PCQTL_CELLTYPE_MANIFEST=""
export SC_PCQTL_JOINT_SCORE_RESPONSE_CHUNK=50

# Slurm settings used by submit_joint_score_array.sh.
export SC_PCQTL_SLURM_PARTITION="normal"
export SC_PCQTL_SLURM_MAX_CONCURRENT=20
export SC_PCQTL_SLURM_SCORE_TIME="04:00:00"
export SC_PCQTL_SLURM_SCORE_MEM="8G"
export SC_PCQTL_SLURM_MERGE_TIME="02:00:00"
export SC_PCQTL_SLURM_MERGE_MEM="16G"
export SC_PCQTL_RSCRIPT="Rscript"
